# Firebrox configuration (copy to .env, or configure live from the web UI)
# All of these can also be set from the Settings panel in the app,
# which persists to .firebrox/settings.json (git-ignored).

PORT=3000

# --- Model provider -----------------------------------------------------------
# One of: openai | anthropic | gemini | groq | ollama | custom | demo
FIREBROX_PROVIDER=demo

# API key for the provider (not needed for ollama or demo)
FIREBROX_API_KEY=

# Model name. Defaults are sensible per provider if left blank.
FIREBROX_MODEL=

# Base URL override (optional).
#   openai    -> https://api.openai.com/v1
#   anthropic -> https://api.anthropic.com/v1
#   gemini    -> https://generativelanguage.googleapis.com/v1beta
#   groq      -> https://api.groq.com/openai/v1
#   ollama    -> http://localhost:11434/v1
#   custom    -> any OpenAI-compatible endpoint (LM Studio, vLLM, Together, ...)
FIREBROX_BASE_URL=

# Sampling temperature (0..2)
FIREBROX_TEMPERATURE=0.7

# Max agent tool-calling steps per message (prevents infinite loops)
FIREBROX_MAX_STEPS=8
